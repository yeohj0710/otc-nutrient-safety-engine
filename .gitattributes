# 원시 PubMed 응답은 SHA-256 재현성을 위해 줄바꿈을 변환하지 않는다.
research_v3/otc/literature/searches/**/*.xml -text

# ---------------------------------------------------------------------------
# 원장이 SHA-256 을 기록하는 경로 (2026-07-31 등록).
#
# core.autocrlf=true 에서는 표시하지 않은 텍스트 파일이 LF 로 커밋되고 CRLF 로 체크아웃되어,
# 내용을 고치지 않았는데도 기록된 해시가 깨진다. 아래 경로는 v50_run_report.json 또는
# v50_protected_final_audit.json 이 해시를 기록하므로 바이트를 고정한다.
#
# 등록 시점에 각 파일의 blob 바이트와 디스크 바이트가 같은지
# `git hash-object --path` 대 `--no-filters` 로 확인했다(전부 일치).
# ---------------------------------------------------------------------------
research_v3/protocol/protocol-v5.0-mecir-search.md -text
research_v3/protocol/amendments.csv                -text
research_v3/logs/v50_run_report.json               -text
research_v3/logs/v50_FINAL.md                      -text
research_v3/logs/DECISIONS_v50.md                  -text

# 기존 LF worktree 바이트를 그대로 요구하는 v5.0 입력만 고정한다. 혼합 줄바꿈 입력은
# checkout 바이트에 의존하지 않고 고정 기준 커밋의 Git blob 계보로 검증한다.
research_v3/otc/normalized/administration_constraints.csv              -text
research_v3/otc/rules/evidence_text_overrides.csv                       -text
research_v3/otc/literature/v5/downstream/literature_link_manifest.json  -text
research_v3/otc/literature/v5/downstream/supporting_literature.csv      -text

# 버전 지도. 해시 기록 대상은 아니지만 여형준 저장소와 같은 규칙을 적용한다.
docs/version_map.md                                -text

# v5.1 감사 산출물은 생성기와 입력의 SHA-256을 서로 기록한다. 새 worktree에서도
# 생성 당시의 LF/CRLF 바이트를 그대로 체크아웃해야 `--check`가 재현된다.
research_v51/**                                    -text whitespace=cr-at-eol
scripts/research/otc/*v51*.py                      -text whitespace=cr-at-eol
src/generated/otc-runtime.json                     -text whitespace=cr-at-eol
src/generated/otc-supporting-literature.json       -text whitespace=cr-at-eol
src/lib/otc/engine.ts                              -text whitespace=cr-at-eol
